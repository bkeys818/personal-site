---
import { socials } from '@data/profile'
---

<footer class="page-width my-0-all !mt-auto py-16 text-center">
  <div class="flex items-center justify-center gap-4 pb-10">
    {
      socials.map(({ name, label, href }) => (
        <a href={href}>
          <img class="icon" src={`/icons/${name}.svg`} alt={`${label} logo`} />
        </a>
      ))
    }
  </div>
  <h4>Ben Keys - Personal Site</h4>
  <p>Copyright © 2023 Ben Keys. All rights reserved.</p>
</footer>
