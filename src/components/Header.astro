---
import { menu } from '@data/site.json'
import { socials } from '@data/profile'
import HamburgerIcon from './HamburgerIcon.astro'
---

<header>
  <div class="page-width my-0-all flex items-center justify-between py-4">
    <a href="/" class="py-0 font-medium">Ben Keys</a>
    <nav class="hidden sm:block">
      <ul class="flex gap-6">
        {
          menu.map(link => (
            <li class="hover-grow">
              <a href={link.href}>{link.name.toUpperCase()}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="hidden gap-4 sm:flex">
      {
        socials.map(({ name, label, href }) => (
          <a href={href}>
            <img
              class="icon"
              src={`/icons/${name}.svg`}
              alt={`${label} logo`}
            />
          </a>
        ))
      }
    </div>
    <HamburgerIcon size={32} />
  </div>
</header>
<dialog
  id="headerModal"
  class="bg-surface invisible fixed top-0 left-0 h-full w-full p-4 opacity-0 transition-opacity duration-200 open:visible open:opacity-100"
>
  <div class="mt-0 flex h-full flex-col gap-4">
    <form method="dialog">
      <button class="float-right">
        <HamburgerIcon size={32} />
      </button>
    </form>
    <a href="/" class="text-center text-4xl font-light">Ben Keys</a>
    <nav class="grow text-center">
      <ul>
        {
          menu.map(link => (
            <li class="my-4">
              <a href={link.href}>{link.name.toUpperCase()}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex justify-center gap-4">
      {
        socials.map(({ name, label, href }) => (
          <a href={href}>
            <img
              class="icon"
              src={`/icons/${name}.svg`}
              alt={`${label} logo`}
            />
          </a>
        ))
      }
    </div>
  </div>
</dialog>
<script>
  const modal = document.getElementById('headerModal')! as HTMLDialogElement
  const navIcon = modal.querySelector('dialog .nav-icon')!
  modal.addEventListener('close', () => {
    document.body.style.removeProperty('overflow')
    navIcon.classList.remove('open')
  })
  document.querySelector('.nav-icon')!.addEventListener('click', () => {
    modal.show()
    document.body.style.overflow = 'hidden'
    navIcon.classList.add('open')
  })
</script>
